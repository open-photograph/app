
# django-payments callbacks: API host without scheme or path.
PAYMENT_HOST=localhost:8000
PAYMENT_USES_SSL=False
STRIPE_WEBHOOK_SECRET=

STRIPE_SECRET_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_SANDBOX=False

# OAuth application for Google login and Drive (tokens remain managed by allauth).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Internal media storage (watermarks, previews and system uploads), separate from original sources.
SYSTEM_STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
AWS_ENDPOINT_URL=
AWS_REGION=us-east-1
AWS_S3_ADDRESSING_STYLE=virtual

# S3 original-file source (independent from AWS_* used by internal storage).
SOURCE_S3_ACCESS_KEY_ID=
SOURCE_S3_SECRET_ACCESS_KEY=
SOURCE_S3_BUCKET_NAME=
SOURCE_S3_ENDPOINT_URL=
SOURCE_S3_REGION_NAME=us-east-1

CLIENT_REQUIRE_VERIFIED_EMAIL_LINK=True
# Core runtime (Railway values are configured on both API and worker).
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Public frontend origin, including scheme and port.
FRONTEND_URL=http://localhost:5173
# Optional overrides; when absent, both lists default to FRONTEND_URL.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
REDIS_URL=redis://localhost:6379/0
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=OPEN-PHOTOGRAPH <noreply@example.com>


# Electronic signatures: use the token belonging to each ZapSign environment.
ZAPSIGN_API_TOKEN=
ZAPSIGN_SANDBOX_API_TOKEN=
